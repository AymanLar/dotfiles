# Dunst Configuration
# Arch Linux dotfiles setup

[global]
    # Display
    monitor = 0
    follow = mouse
    geometry = "300x5-30+20"
    indicate_hidden = yes
    shrink = no
    transparency = 0
    notification_height = 0
    separator_height = 2
    padding = 8
    horizontal_padding = 8
    separator_color = frame
    sort = yes
    idle_threshold = 120

    # Text
    font = JetBrains Mono 9
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    # Icons
    icon_position = left
    max_icon_size = 32
    icon_path = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/:/usr/share/icons/gnome/16x16/apps/

    # History
    history_length = 20
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/firefox -new-tab

    # Mouse
    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

[shortcuts]
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period

[urgency_low]
    background = "#2E3440"
    foreground = "#ECEFF4"
    frame_color = "#5E81AC"
    timeout = 4

[urgency_normal]
    background = "#2E3440"
    foreground = "#ECEFF4"
    frame_color = "#81A1C1"
    timeout = 6

[urgency_critical]
    background = "#2E3440"
    foreground = "#ECEFF4"
    frame_color = "#BF616A"
    timeout = 0

# Rules
[appname="Spotify"]
    format = "<b>%s</b>\n%b"
    icon = spotify
    urgency = low

[appname="Firefox"]
    format = "<b>%s</b>\n%b"
    icon = firefox
    urgency = normal

[appname="Alacritty"]
    format = "<b>%s</b>\n%b"
    icon = terminal
    urgency = normal

[appname="Sway"]
    format = "<b>%s</b>\n%b"
    icon = sway
    urgency = normal

[appname="NetworkManager"]
    format = "<b>%s</b>\n%b"
    icon = network-wireless
    urgency = normal

[appname="PulseAudio"]
    format = "<b>%s</b>\n%b"
    icon = audio-volume-high
    urgency = low

[appname="Battery"]
    format = "<b>%s</b>\n%b"
    icon = battery
    urgency = critical

[appname="System"]
    format = "<b>%s</b>\n%b"
    icon = system
    urgency = normal
